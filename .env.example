# hoodrat — example environment configuration
# Copy to .env and fill in the non-sensitive values.
# DO NOT put passwords or tokens in this file.

# Trading mode: paper (default) or live
TRADING_MODE=paper

# Which account to use: agentic (default) or machine
ACCOUNT_TARGET=agentic

# How long the bot waits between loop cycles (seconds)
POLL_INTERVAL_SECS=300

# Override the paper trading starting cash (only used before the first
# real-account sync; after that the real balance is the baseline)
# PAPER_STARTING_CASH=25000

# ── Robinhood Machine account (unofficial MCP) ────────────────────────────
# Credentials live in your OS keychain, NOT here.
# Run this once to set them up:
#
#   python scripts/robinhood_machine_mcp.py --setup
#
