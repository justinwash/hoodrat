import { Button, GroupBox, HorizontalBox, ScrollView, VerticalBox } from "std-widgets.slint";

export component MainWindow inherits Window {
    in property <string> bot_status: "UNKNOWN";
    in property <string> execution_mode: "disabled";
    in property <string> portfolio_value: "—";
    in property <string> buying_power: "—";
    in property <string> realized_pnl: "—";
    in property <string> reconciliation_status: "not_run";
    in property <string> reconciliation_details: "No reconciliation recorded.";
    in property <string> last_run: "No runs recorded";
    in property <string> last_run_status: "—";
    in property <string> database_path: "—";
    in property <string> risk_status: "Not confirmed";
    in property <string> recent_events: "No agent events recorded.";
    callback run_now();
    callback refresh();
    callback toggle_kill_switch();

    min-width: 900px;
    min-height: 600px;
    background: #10141c;

    VerticalBox {
        padding: 24px;
        spacing: 16px;

        HorizontalBox {
            spacing: 16px;
            Text {
                text: "HOODRAT";
                color: #f3f4f6;
                font-size: 30px;
                font-weight: 700;
            }
            Text {
                text: "agentic trading supervisor";
                color: #9ca3af;
                vertical-alignment: center;
                font-size: 15px;
            }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Refresh"; clicked => { root.refresh(); } }
            Button { text: "Run evaluation"; clicked => { root.run_now(); } }
            Button { text: "Toggle kill switch"; clicked => { root.toggle_kill_switch(); } }
        }

        GroupBox {
            title: "Read-only reconciliation";
            VerticalBox {
                padding: 12px;
                spacing: 6px;
                Text { text: root.reconciliation_status; color: root.reconciliation_status == "baseline" || root.reconciliation_status == "reconciled" ? #86efac : #fca5a5; font-size: 16px; }
                Text { text: root.reconciliation_details; color: #d1d5db; font-size: 12px; wrap: word-wrap; }
            }
        }

        HorizontalBox {
            spacing: 12px;
            GroupBox {
                title: "Bot";
                HorizontalBox {
                    padding: 12px;
                    spacing: 12px;
                    Text {
                        text: root.bot_status;
                        color: root.bot_status == "LOCKED" ? #fca5a5 : #86efac;
                        font-size: 18px;
                    }
                    Text { text: root.execution_mode; color: #d1d5db; vertical-alignment: center; }
                }
            }
            GroupBox {
                title: "Risk policy";
                HorizontalBox {
                    padding: 12px;
                    Text { text: root.risk_status; color: #fbbf24; font-size: 16px; }
                }
            }
            GroupBox {
                title: "Last run";
                HorizontalBox {
                    padding: 12px;
                    spacing: 8px;
                    Text { text: root.last_run; color: #d1d5db; }
                    Text { text: root.last_run_status; color: #93c5fd; }
                }
            }
        }

        HorizontalBox {
            spacing: 12px;
            GroupBox {
                title: "Portfolio value";
                VerticalBox { padding: 16px; Text { text: root.portfolio_value; color: #f3f4f6; font-size: 26px; } }
            }
            GroupBox {
                title: "Buying power";
                VerticalBox { padding: 16px; Text { text: root.buying_power; color: #f3f4f6; font-size: 26px; } }
            }
            GroupBox {
                title: "Realized PnL";
                VerticalBox { padding: 16px; Text { text: root.realized_pnl; color: #86efac; font-size: 26px; } }
            }
        }

        GroupBox {
            title: "Recent agent events";
            VerticalBox {
                padding: 12px;
                ScrollView {
                    viewport-height: 180px;
                    Text {
                        text: root.recent_events;
                        color: #d1d5db;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                }
            }
        }

        Rectangle { vertical-stretch: 1; }
        Text {
            text: "State: " + root.database_path + "   |   Direct MCP mode: Rust auditing is not a pre-trade firewall.";
            color: #6b7280;
            font-size: 12px;
        }
    }
}