{
  "schema_version": 1,
  "execution": {
    "mode": "disabled",
    "kill_switch_engaged": true
  },
  "agent": {
    "executable": "cline",
    "working_directory": null,
    "config_dir": "data/cline",
    "data_dir": "data/cline/data",
    "provider": "openrouter",
    "model": "gpt-5.6-luna",
    "timeout_secs": 300,
    "auto_approve": true,
    "session_mode": "fresh"
  },
  "robinhood": {
    "trading_mcp_url": "https://agent.robinhood.com/mcp/trading",
    "mcp_server_name": "robinhood-trading",
    "agentic_account_only": true,
    "connection_ready": false
  },
  "schedule": {
    "equity_options": {
      "enabled": true,
      "interval_secs": 300,
      "timezone": "America/New_York",
      "start_local": "09:35",
      "end_local": "15:55"
    },
    "crypto": {
      "enabled": true,
      "interval_secs": 900
    }
  },
  "risk": {
    "confirmed": false,
    "max_order_notional_usd": 1000.0,
    "daily_loss_limit_usd": 250.0,
    "max_total_exposure_usd": 5000.0,
    "max_concurrent_positions": 10,
    "max_option_dte": 1,
    "max_crypto_exposure_usd": 1000.0,
    "max_bid_ask_spread_bps": 150,
    "max_quote_age_secs": 30,
    "duplicate_order_cooldown_secs": 60
  },
  "strategy": {
    "contract_version": "canary-v1",
    "canary_enabled": false,
    "allowed_lanes": [
      "crypto"
    ],
    "allowed_asset_classes": [
      "crypto"
    ],
    "approved_symbols": [],
    "order_type": "limit",
    "sizing_mode": "fixed_notional",
    "fixed_order_notional_usd": 25.0,
    "max_order_notional_usd": 25.0,
    "daily_loss_limit_usd": 25.0,
    "max_total_exposure_usd": 100.0,
    "duplicate_order_cooldown_secs": 3600,
    "minimum_interval_secs": 900,
    "allow_options": false,
    "allow_leverage": false,
    "no_op_conditions": [
      "no approved symbol or asset class match",
      "quote is missing, stale, or outside the spread policy",
      "daily loss, exposure, position, or notional limit would be exceeded",
      "duplicate-order cooldown or ambiguous prior run is active",
      "any unexpected tool, MCP error, reconciliation drift, or failed audit"
    ]
  },
  "storage": {
    "database_path": "data/hoodrat.db"
  },
  "ui": {
    "refresh_secs": 2
  }
}